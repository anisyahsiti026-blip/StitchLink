<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StitchLink - Komunitas Penjahit Indonesia</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Outfit', sans-serif;
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .hero-pattern {
            background-color: #0f172a;
            background-image: 
                radial-gradient(at 47% 33%, hsla(262, 77%, 46%, 0.12) 0, transparent 59%), 
                radial-gradient(at 82% 65%, hsla(218, 100%, 50%, 0.15) 0, transparent 55%);
        }
        
        .card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .card-hover:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(102, 126, 234, 0.4);
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        .float-animation {
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
        }
    </style>
</head>
<body class="bg-slate-950 text-white">
    <!-- Navbar -->
    <nav class="fixed top-0 w-full z-50 bg-slate-950/80 backdrop-blur-lg border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 gradient-bg rounded-xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                        </svg>
                    </div>
                    <span class="text-xl font-bold">Stitch<span class="gradient-text">Link</span></span>
                </div>
                
                <div class="flex items-center space-x-4">
                    <a href="login.html" class="px-6 py-2.5 text-sm font-medium text-slate-300 hover:text-white transition-colors">
                        Masuk
                    </a>
                    <a href="register.html" class="px-6 py-2.5 text-sm font-semibold gradient-bg rounded-xl hover:opacity-90 transition-all transform hover:scale-105">
                        Daftar Gratis
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-pattern min-h-screen flex items-center pt-20">
        <div class="max-w-7xl mx-auto px-6 py-20">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="space-y-8 fade-in-up">
                    <div class="inline-block px-4 py-2 bg-purple-500/10 border border-purple-500/20 rounded-full">
                        <span class="text-sm font-medium gradient-text">✨ Komunitas Penjahit Terbesar di Indonesia</span>
                    </div>
                    
                    <h1 class="text-5xl md:text-7xl font-bold leading-tight">
                        Berbagi <span class="gradient-text">Karya</span>,<br/>
                        Belajar <span class="gradient-text">Bersama</span>
                    </h1>
                    
                    <p class="text-xl text-slate-400 leading-relaxed">
                        Bergabunglah dengan ribuan penjahit berbakat. Bagikan hasil jahitan, dapatkan inspirasi, dan tingkatkan skill Anda bersama komunitas.
                    </p>
                    
                    <div class="flex flex-wrap gap-4">
                        <a href="register.html" class="px-8 py-4 gradient-bg rounded-xl font-semibold text-lg hover:opacity-90 transition-all transform hover:scale-105 shadow-xl shadow-purple-500/20">
                            Mulai Sekarang →
                        </a>
                        <a href="#features" class="px-8 py-4 bg-slate-800 rounded-xl font-semibold text-lg hover:bg-slate-700 transition-all">
                            Pelajari Lebih Lanjut
                        </a>
                    </div>
                    
                    <div class="flex items-center space-x-8 pt-4">
                        <div>
                            <div class="text-3xl font-bold gradient-text">1,000+</div>
                            <div class="text-sm text-slate-400">Anggota Aktif</div>
                        </div>
                        <div>
                            <div class="text-3xl font-bold gradient-text">5,000+</div>
                            <div class="text-sm text-slate-400">Karya Dibagikan</div>
                        </div>
                        <div>
                            <div class="text-3xl font-bold gradient-text">24/7</div>
                            <div class="text-sm text-slate-400">Chat Support</div>
                        </div>
                    </div> 
                </div>
                
                <div class="relative float-animation">
                    <div class="absolute inset-0 gradient-bg opacity-20 blur-3xl rounded-full"></div>
                    <img src="https://i.pinimg.com/1200x/d7/47/0a/d7470ac848909249d2c00651be863dff.jpg" 
                         alt="Tailor Community" 
                         class="relative rounded-3xl shadow-2xl border border-slate-700">
                </div>  
            </div>
        </div> 
    </section>

    <!-- Features Section -->
    <section id="features" class="py-24 bg-slate-900">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold mb-4">Fitur <span class="gradient-text">Unggulan</span></h2>
                <p class="text-xl text-slate-400">Semua yang Anda butuhkan untuk berkembang sebagai penjahit</p>
            </div>
            
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Feature 1: Galeri Karya -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Galeri Karya</h3>
                    <p class="text-slate-400 leading-relaxed">Pamerkan hasil jahitan terbaik Anda. Upload foto, tambahkan caption & hashtag, dan dapatkan like serta komentar dari komunitas.</p>
                </div>
                
                <!-- Feature 2: Forum Diskusi -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Forum Diskusi</h3>
                    <p class="text-slate-400 leading-relaxed">Chat grup real-time bertenaga Socket.IO. Tanya jawab, berbagi tips, dan bangun networking yang solid bersama penjahit lain.</p>
                </div>
                
                <!-- Feature 3: Direct Message -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Direct Message</h3>
                    <p class="text-slate-400 leading-relaxed">Chat privat satu lawan satu dengan dukungan kirim teks dan gambar, daftar percakapan, badge unread, serta notifikasi pesan baru.</p>
                </div>
                
                <!-- Feature 4: Kompetisi -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Kompetisi</h3>
                    <p class="text-slate-400 leading-relaxed">Ikuti lomba desain dan jahit untuk unjuk skill, voting karya favorit, dan menangkan apresiasi dari komunitas penjahit Indonesia.</p>
                </div>
                
                <!-- Feature 6: Profil & Portofolio -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Profil & Portofolio</h3>
                    <p class="text-slate-400 leading-relaxed">Profil personal lengkap dengan bio, galeri grid ala Instagram, statistik post & like, follower, serta tombol kirim pesan langsung.</p>
                </div>
                
                <!-- Feature 7: Follow & Hashtag -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Follow & Hashtag</h3>
                    <p class="text-slate-400 leading-relaxed">Ikuti penjahit favorit, lihat feed khusus following, dan jelajahi karya berdasarkan hashtag seperti #wedding, #gaun, #pengantin.</p>
                </div>
                
                <!-- Feature 8: Notifikasi -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Notifikasi Real-time</h3>
                    <p class="text-slate-400 leading-relaxed">Dapatkan info instan saat ada like, komentar, follower baru, atau postingan dari user yang Anda ikuti, lengkap dengan badge unread.</p>
                </div>
                
                <!-- Feature 9: Komunitas -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Komunitas Solid</h3>
                    <p class="text-slate-400 leading-relaxed">Bertemu dengan ribuan penjahit dari seluruh Indonesia. Saling support, berbagi ilmu, dan berkembang bersama dalam satu wadah.</p>
                </div>
                
                <!-- Feature 10: Admin & Moderasi -->
                <div class="card-hover bg-slate-800 p-8 rounded-2xl border border-slate-700">
                    <div class="w-14 h-14 gradient-bg rounded-xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Admin & Moderasi</h3>
                    <p class="text-slate-400 leading-relaxed">Panel admin untuk moderasi konten, hapus postingan tidak pantas, kelola user, dan ban akun yang melanggar aturan komunitas.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 hero-pattern">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                Siap Bergabung dengan <span class="gradient-text">Komunitas</span>?
            </h2>
            <p class="text-xl text-slate-400 mb-10">
                Daftar gratis sekarang dan mulai berbagi karya Anda hari ini
            </p>
            <a href="register.html" class="inline-block px-10 py-5 gradient-bg rounded-xl font-bold text-xl hover:opacity-90 transition-all transform hover:scale-105 shadow-2xl shadow-purple-500/30">
                Daftar Gratis Sekarang →
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-4 md:mb-0">
                    <span class="text-xl font-bold">Stitch<span class="gradient-text">Link</span></span>
                    <p class="text-slate-400 text-sm mt-2">© 2026 - Komunitas Penjahit Indonesia</p>
                </div>
                <div class="flex space-x-6">
                    <a href="#" class="text-slate-400 hover:text-white transition-colors">Tentang</a>
                    <a href="#" class="text-slate-400 hover:text-white transition-colors">Kontak</a>
                    <a href="#" class="text-slate-400 hover:text-white transition-colors">Privasi</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
